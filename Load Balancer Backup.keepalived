vi /etc/keepalived/keepalived.conf
global_defs {
  router_id lb2  # The hostname of this host.
}
vrrp_script nginx {
  script "/usr/bin/killall -0 nginx"
  interval 2
  weight 2
}
vrrp_instance 51 {
  virtual_router_id 51
  advert_int 1
  priority 51
  state BACKUP
  interface enp0s8
  virtual_ipaddress {
     192.168.56.180 # The virtual IP address that will be shared between MASTER and BACKUP
  }
  track_script {
      nginx
  }
}

ip -br a #Testing
lo               UNKNOWN        127.0.0.1/8 ::1/128
enp0s3           UP             10.0.2.15/24 fd00::a00:27ff:fe3b:6b2b/64 fe80::a00:27ff:fe3b:6b2b/64
enp0s8           UP             192.168.56.110/24 fe80::f28b:e9ac:7eaf:37b2/64
