vim /etc/keepalived/keepalived.conf

global_defs {
  router_id lb1  # The hostname of this host.
}
vrrp_script nginx {
  script "/usr/bin/killall -0 nginx"
  interval 2
  weight 2
}
vrrp_instance 51 {
  virtual_router_id 51
  advert_int 1
  priority 52
  state MASTER
  interface ens160
  virtual_ipaddress {
     192.168.83.180 # The virtual IP address that will be shared between MASTER and BACKUP
  }
  track_script {
      nginx
  }
}
ip -br a #Testing
lo               UNKNOWN        127.0.0.1/8 ::1/128
enp0s3           UP             10.0.2.15/24 fd00::a00:27ff:fed0:634b/64 fe80::a00:27ff:fed0:634b/64
enp0s8           UP             192.168.56.108/24 192.168.83.180/32 fe80::3396:471a:95d4:5178/64
[root@lb1 keepalived]#
