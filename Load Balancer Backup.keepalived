vi /etc/keepalived/keepalived.conf
global_defs {
  router_id lb2  # The hostname of this host.
}
vrrp_script nginx {
  script "/usr/bin/killall -0 nginx"
  interval 2
  weight 2
}
vrrp_instance 51 {
  virtual_router_id 51
  advert_int 1
  priority 51
  state BACKUP
  interface enp0s8
  virtual_ipaddress {
     192.168.83.180 # The virtual IP address that will be shared between MASTER and BACKUP
  }
  track_script {
      nginx
  }
}

[root@lb2 ~]#
